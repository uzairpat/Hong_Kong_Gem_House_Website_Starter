NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hkg_gem_house_app:YOUR_URL_ENCODED_LOCAL_PASSWORD@localhost:5432/hk_gem_house_admin_dev
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_BASE_URL=http://localhost:5173

# One-time owner bootstrap. Set temporarily, run npm run admin:bootstrap once,
# then remove ADMIN_OWNER_PASSWORD from the environment.
ADMIN_OWNER_EMAIL=owner@example.com
ADMIN_OWNER_PASSWORD=
# Generate a random 32-byte key and base64-encode it.
# Keep stable and private after MFA enrollment.
MFA_ENCRYPTION_KEY=

# Optional SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
