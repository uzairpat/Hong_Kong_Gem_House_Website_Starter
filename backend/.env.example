NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/hk_gem_house_dev
DATABASE_SSL=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_BASE_URL=http://localhost:5173

# One-time owner bootstrap. Set the password temporarily, run npm run admin:bootstrap,
# then remove ADMIN_OWNER_PASSWORD from the environment.
ADMIN_OWNER_EMAIL=owner@example.com
ADMIN_OWNER_PASSWORD=
# Generate a 32-byte key and base64-encode it. Keep stable and private after MFA setup.
MFA_ENCRYPTION_KEY=

# Optional production SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
